# Key stays on the backend. Manual simulation and algorithmic search work without it.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
AI_ENABLED=true
AI_PROVIDER=openai
AI_ALLOW_TEMPLATE_FALLBACK=false
AI_MAX_MODEL_CALLS_PER_RUN=6
AI_MAX_TOOL_CALLS_PER_RUN=8
AI_MAX_REPAIR_ROUNDS=2
AI_MAX_CANDIDATES=3
AI_MAX_INPUT_TOKENS=12000
AI_MAX_OUTPUT_TOKENS=2500
AI_RUN_TIMEOUT_SECONDS=120
AI_MAX_CONCURRENT_RUNS=1
AI_DAILY_SPEND_LIMIT_USD=2
AI_RUN_ESTIMATED_COST_LIMIT_USD=0.10
ALLOW_LIVE_AI_TESTS=false
# Optional absolute paths; by default var/akim.sqlite3 and data/ai_pricing.json.
# DB_PATH=
# AI_PRICING_PATH=
# Used by the Next.js server for same-origin API requests in local development.
BACKEND_URL=http://127.0.0.1:8000

