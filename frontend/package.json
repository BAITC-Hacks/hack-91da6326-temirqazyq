{
  "name": "akim-ai-frontend",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "next build --webpack",
    "start": "next start --hostname 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test tests/*.test.mjs",
    "format": "prettier --write src next.config.ts tailwind.config.ts postcss.config.mjs tsconfig.json package.json",
    "format:check": "prettier --check src next.config.ts tailwind.config.ts postcss.config.mjs tsconfig.json package.json"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "next": "^16.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "recharts": "^3.3.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "prettier": "^3.9.9",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2"
  }
}
