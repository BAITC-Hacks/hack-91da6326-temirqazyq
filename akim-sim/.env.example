# --- LLM (необязательно: без ключа работает шаблонный режим объяснений) ---
# Вариант 1: OpenAI
LLM_PROVIDER=openai
LLM_API_KEY=sk-...
LLM_MODEL=gpt-4o-mini

# Вариант 2: NVIDIA NIM (OpenAI-совместимый API)
# LLM_PROVIDER=nvidia
# LLM_API_KEY=nvapi-...
# LLM_MODEL=meta/llama-3.1-70b-instruct
# LLM_BASE_URL=https://integrate.api.nvidia.com/v1

# Вариант 3: любой OpenAI-совместимый сервер (vLLM, Ollama, LM Studio)
# LLM_PROVIDER=custom
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=qwen2.5:14b
# LLM_API_KEY=ollama

LLM_TEMPERATURE=0.3
LLM_TIMEOUT=60
LLM_MAX_TOKENS=2048

# Дополнительные поля в теле каждого запроса к модели (валидный JSON-объект).
# Нужно, например, чтобы отключить reasoning у Nemotron за vLLM:
# LLM_EXTRA_BODY={"chat_template_kwargs": {"enable_thinking": false}}

# --- прочее ---
# AKIM_DB_PATH=/data/akim.db
# AKIM_ALLOW_RESET=1
# AKIM_DATA_DIR=../data
# AKIM_FRONTEND_DIST=../frontend/dist
